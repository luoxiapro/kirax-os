{
  "informationForXcode": "",
  "name": "kirax-os",
  "displayName": "KiraX OS",
  "description": "KiraX OS .kir 应用语法高亮与打包",
  "version": "0.1.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "space",
        "aliases": ["KiraX OS", "space"],
        "extensions": [".space", ".kir.rs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "space",
        "scopeName": "source.space",
        "path": "./syntaxes/space.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "space.package", "title": "KiraX OS: 打包 .kir" }
    ]
  }
}
